<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GhostDriveApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GhostDriveApp">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="CliProblem" Grid.Row="0" Severity="Error" IsClosable="False"
                 Title="ghostdrive.exe not found" />

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False" OpenPaneLength="200"
                        SelectionChanged="OnNavigationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="HomeItem" Content="Home" Tag="home" Icon="Home" />
                <NavigationViewItem x:Name="DevicesItem" Content="Devices" Tag="devices" Icon="AllApps" />
                <NavigationViewItem x:Name="AddItem" Content="Add device" Tag="add" Icon="Add" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsItem" Content="Settings" Tag="settings" Icon="Setting" />
            </NavigationView.FooterMenuItems>

            <ScrollViewer HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid Padding="32,24,32,32" MaxWidth="820" HorizontalAlignment="Left">
                    <local:FirstRunView x:Name="FirstRunPage" Visibility="Collapsed" />
                    <local:HomeView x:Name="HomePage" Visibility="Collapsed" />
                    <local:DevicesView x:Name="DevicesPage" Visibility="Collapsed" />
                    <local:AddDeviceView x:Name="AddPage" Visibility="Collapsed" />
                    <local:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
