<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GhostDriveApp.DevicesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="16">
        <TextBlock Text="Devices" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock x:Name="Summary" TextWrapping="Wrap"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <InfoBar x:Name="Result" Visibility="Collapsed" IsClosable="True" />
        <StackPanel x:Name="List" Spacing="8" />
    </StackPanel>
</UserControl>
