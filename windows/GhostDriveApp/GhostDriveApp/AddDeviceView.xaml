<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GhostDriveApp.AddDeviceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="16">
        <TextBlock Text="Add a device" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock TextWrapping="Wrap"
                   Text="Create a one-time invite code here and enter it on the device you want to add." />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="CreateButton" Content="Create invite code" Style="{StaticResource AccentButtonStyle}"
                    Click="OnCreate" />
            <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
        </StackPanel>
        <InfoBar x:Name="Result" Visibility="Collapsed" IsClosable="True" />

        <Border x:Name="CodeCard" Visibility="Collapsed" Padding="20" CornerRadius="8" BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="12">
                <TextBlock x:Name="CodeText" FontFamily="Consolas" FontSize="26" TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="CopyButton" Content="Copy code" Click="OnCopy" />
                    <TextBlock x:Name="CountdownText" VerticalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    On the other device, install GhostDrive and choose Join with an invite code (or run
                    ghostdrive join followed by the code), then enter this code. It works once. Anyone who has
                    it can join your drive, so send it privately. Both devices must be on the same network,
                    or set to the same rendezvous server.
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
