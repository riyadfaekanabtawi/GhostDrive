<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GhostDriveApp.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="28">
        <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

        <StackPanel Spacing="12">
            <TextBlock Text="GhostDrive" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="StartButton" Content="Start GhostDrive" Style="{StaticResource AccentButtonStyle}"
                        Click="OnStart" />
                <Button x:Name="StopButton" Content="Stop GhostDrive" Click="OnStop" />
                <ProgressRing x:Name="RunBusy" IsActive="False" Width="20" Height="20" />
                <TextBlock x:Name="RunState" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <ToggleSwitch x:Name="LoginSwitch" Header="Start at login" OffContent="Off" OnContent="On"
                          Toggled="OnLoginToggled" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Start at login registers a Task Scheduler task that runs GhostDrive when you sign in, and starts it now. Turning it off also stops GhostDrive." />
            <InfoBar x:Name="RunResult" Visibility="Collapsed" IsClosable="True" />
        </StackPanel>

        <StackPanel Spacing="12">
            <TextBlock Text="Rendezvous server" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Devices on different networks find each other through a rendezvous server you run (ghostdrive-rendezvous). It forwards only encrypted packets. Enter its address and the fingerprint it printed." />
            <TextBlock x:Name="RendezvousCurrent" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBox x:Name="RendezvousAddress" Header="Address" PlaceholderText="rv.example.org:7374" />
            <TextBox x:Name="RendezvousFingerprint" Header="Fingerprint"
                     PlaceholderText="As printed by ghostdrive-rendezvous" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RendezvousButton" Content="Set server" Click="OnSetRendezvous" />
                <ProgressRing x:Name="RendezvousBusy" IsActive="False" Width="20" Height="20" />
            </StackPanel>
            <InfoBar x:Name="RendezvousResult" Visibility="Collapsed" IsClosable="True" />
        </StackPanel>

        <StackPanel Spacing="12">
            <TextBlock Text="Folders" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBox x:Name="DataFolderBox" Header="Data folder" />
            <TextBox x:Name="MountBox" Header="Mount location (a drive letter such as G:, or a folder)" />
            <TextBox x:Name="CliBox" Header="ghostdrive tool (ghostdrive.exe)" />
            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Leave a box empty for the default. A new mount location applies the next time GhostDrive starts." />
            <Button x:Name="SaveButton" Content="Save" Click="OnSave" />
            <InfoBar x:Name="SaveResult" Visibility="Collapsed" IsClosable="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
