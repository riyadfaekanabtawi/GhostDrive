<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="GhostDriveApp.FirstRunView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="16" MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="Set up GhostDrive" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock TextWrapping="Wrap"
                   Text="GhostDrive is a drive made of your own devices. This PC is not part of a drive yet: create a new one, or join a drive you already use on another device." />

        <StackPanel x:Name="Choices" Spacing="12">
            <Button x:Name="CreateChoice" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="16,12" Click="OnChooseCreate">
                <StackPanel Spacing="2">
                    <TextBlock Text="Create a new drive" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Start a drive on this PC, then add your other devices." TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Button>
            <Button x:Name="JoinChoice" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="16,12" Click="OnChooseJoin">
                <StackPanel Spacing="2">
                    <TextBlock Text="Join with an invite code" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Add this PC to a drive. Create the code on a device that is already in it."
                               TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel x:Name="Form" Spacing="12" Visibility="Collapsed">
            <TextBlock x:Name="FormTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBox x:Name="NameBox" Header="Name for this PC" MaxLength="64"
                     PlaceholderText="For example: Desk PC" />
            <TextBox x:Name="CodeBox" Header="Invite code" Visibility="Collapsed"
                     PlaceholderText="gd1-..." FontFamily="Consolas" TextWrapping="Wrap"
                     AcceptsReturn="False" />
            <TextBlock x:Name="CodeHelp" Visibility="Collapsed" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="On a device already in the drive, open Add device (or run ghostdrive invite) and paste the code here. Both devices need to be on the same network, or use the same rendezvous server." />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RunButton" Style="{StaticResource AccentButtonStyle}" Click="OnRun" />
                <Button x:Name="BackButton" Content="Back" Click="OnBack" />
                <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
                <TextBlock x:Name="BusyText" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <InfoBar x:Name="Result" Visibility="Collapsed" IsClosable="True" />

        <TextBlock x:Name="DataFolderText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </StackPanel>
</UserControl>
