<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything the app decides without a window: the ghostdrive command lines, parsing their
       output, and cleaning text for display. Plain net8.0, so the tests run on any OS. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>GhostDriveApp.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
